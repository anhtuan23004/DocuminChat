# Single-user local development. Ports bind 127.0.0.1 in compose.yaml.
APP_ENV=development
# scripts/bootstrap_env.py fills this once with a random password.
POSTGRES_PASSWORD=
# External OpenAI-compatible inference, e.g. Colab HTTPS tunnel /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
